{
  "name": "klyselz-system",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio-ready automation platform for DACH service businesses",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:site": "npm --prefix apps/site run dev",
    "dev:owner-admin": "npm --prefix apps/owner-admin run dev",
    "dev:client-dashboard": "npm --prefix apps/client-dashboard run dev",
    "build": "npm run build:site && npm run build:owner-admin && npm run build:client-dashboard",
    "build:site": "npm --prefix apps/site run build",
    "build:owner-admin": "npm --prefix apps/owner-admin run build",
    "build:client-dashboard": "npm --prefix apps/client-dashboard run build",
    "typecheck": "npm run typecheck:site && npm run typecheck:owner-admin && npm run typecheck:client-dashboard",
    "typecheck:site": "npm --prefix apps/site run typecheck",
    "typecheck:owner-admin": "npm --prefix apps/owner-admin run typecheck",
    "typecheck:client-dashboard": "npm --prefix apps/client-dashboard run typecheck",
    "leadgen:dry-run": "npm --prefix tools/prospect-pipeline run dry-run",
    "leadgen:sync": "npm --prefix tools/prospect-pipeline run sync",
    "test": "node --test tests/*.test.mjs",
    "security:public": "node scripts/validate-public-repo.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run security:public && npm test && npm run typecheck && npm run build && npm run leadgen:dry-run"
  },
  "workspaces": [
    "apps/site",
    "apps/owner-admin",
    "apps/client-dashboard",
    "tools/prospect-pipeline"
  ],
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8",
    "next@16.2.11": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
