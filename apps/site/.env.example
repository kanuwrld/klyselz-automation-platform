# Copy to .env.local for local dev. In Vercel, add same keys under Project Settings.
DATABASE_URL=""

# Agency CRM database for inbound leads. Usually same Neon URL as owner-admin DATABASE_URL.
CRM_DATABASE_URL=""

# Resend mail delivery.
RESEND_API_KEY=""
RESEND_FROM="KLYSELZ <hello@example.com>"
OWNER_EMAIL="owner@example.com"

NEXT_PUBLIC_SITE_URL="https://klyselz.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.klyselz.com"

# Keep false for public portfolio deployments. Enable only after legal pages,
# CRM storage, retention and operator notification are production-ready.
NEXT_PUBLIC_CONTACT_ENABLED="false"

# Telegram-Notify. BotFather -> /newbot -> token.
# Chat ID: send the bot a message, then inspect getUpdates. Separate multiple IDs with commas.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
